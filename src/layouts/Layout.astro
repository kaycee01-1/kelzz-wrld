---
const { title, page, description } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@800;900&family=Manrope:wght@400;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/site.css">
  <title>{title}</title>
  {description && <meta name="description" content={description}>}
</head>
<body data-page={page}>
  <slot />
  <script is:inline src="/site.js"></script>
</body>
</html>
